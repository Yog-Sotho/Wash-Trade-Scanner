# Database — use strong passwords in production
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wash_detector
DATABASE_USER=wash_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_123
DATABASE_SSL_MODE=require

# Redis
REDIS_URL=redis://localhost:6379/0

# RPC URLs — replace with your actual endpoints
# Use authenticated endpoints; never commit real keys
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE
BSC_RPC_URL=https://bsc-dataseed1.binance.org
POLYGON_RPC_URL=https://polygon.drpc.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FANTOM_RPC_URL=https://rpcapi.fantom.network
CELO_RPC_URL=https://forno.celo.org
GNOSIS_RPC_URL=https://rpc.gnosischain.com
MOONBEAM_RPC_URL=https://rpc.api.moonbeam.network
AURORA_RPC_URL=https://mainnet.aurora.dev
HARMONY_RPC_URL=https://api.harmony.one
CRONOS_RPC_URL=https://evm.cronos.org
METIS_RPC_URL=https://andromeda.metis.io/?owner=1088
BOBA_RPC_URL=https://mainnet.boba.network
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io
POLYGON_ZKEVM_RPC_URL=https://zkevm-rpc.com
LINEA_RPC_URL=https://rpc.linea.build
SCROLL_RPC_URL=https://rpc.scroll.io
MANTLE_RPC_URL=https://rpc.mantle.xyz
KAVA_RPC_URL=https://evm.kava.io
KLAYTN_RPC_URL=https://public-en.node.kaia.io

# Detection Parameters
WASH_TRADE_TIME_WINDOW_MINUTES=60
MIN_WASH_TRADE_VOLUME_USD=1000

# Scoring: a hit counts as wash when P(wash | hit), from each detector's measured
# rates (config/detector_calibration.json) and this prior, reaches the threshold.
WASH_PRIOR=0.01
SUSPICIOUS_ACTIVITY_THRESHOLD=0.8

# Round trips (after Chainalysis wash-trading heuristic 1; tuned on docs/benchmarks.md)
ROUND_TRIP_MAX_BLOCKS=50
ROUND_TRIP_VALUE_TOLERANCE=0.01
ROUND_TRIP_MIN_COUNT=2

# Bot Detection Thresholds
BOT_TRADE_COUNT_THRESHOLD=10
BOT_TRADE_TIME_THRESHOLD_SECONDS=60
BOT_VOLUME_CV_THRESHOLD=0.5

# Volume Anomaly — mad, iqr, or zscore
VOLUME_ANOMALY_METHOD=mad
VOLUME_ANOMALY_THRESHOLD=3.5
VOLUME_ANOMALY_BUCKET_MINUTES=60
VOLUME_ANOMALY_MIN_TRADES=5

# Position neutrality per trader / funding cluster (Victor & Weintraud, WWW '21)
POSITION_NEUTRAL_MARGIN=0.001
POSITION_NEUTRAL_MIN_TRADES=4

# Advanced Detection — closed clusters (network-based, 2025)
CLOSED_CLUSTER_INTERNAL_RATIO=0.9
CLOSED_CLUSTER_MIN_TRADES=6
CLOSED_CLUSTER_MIN_MEMBERS=2
CLOSED_CLUSTER_MAX_MEMBERS=50
CLOSED_CLUSTER_BALANCE_TOLERANCE=0.2

# Advanced Detection — repeated-amount fingerprinting
REPEATED_AMOUNT_MIN_COUNT=5
REPEATED_AMOUNT_SIG_FIGS=3

# ML Model
ML_MODEL_PATH=models/ml_model.pkl
ML_CONTAMINATION=0.05
ML_EXPLAINABILITY=true
# wash-train: threshold at this false-positive rate on the benchmark's honest trades,
# and refuse models whose PR-AUC is below this multiple of a random ranking's
ML_TARGET_FPR=0.01
ML_MIN_PR_AUC_LIFT=2.0

# Data Retention
TRADE_RETENTION_DAYS=90

# API Server — loopback by default. To expose publicly you MUST enable auth:
# the server refuses to bind a non-loopback host without it.
API_HOST=127.0.0.1
API_PORT=8000
API_AUTH_ENABLED=false
# Comma-separated SHA-256 hashes of accepted API keys (generate with `wash-genkey`)
API_KEY_HASHES=
# Comma-separated origins allowed for CORS (leave empty to disable CORS)
API_CORS_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=120
API_DOCS_ENABLED=true
# Enable only when serving over HTTPS (behind a TLS-terminating proxy)
API_HSTS_ENABLED=false

# Web Panel (served at /panel)
PANEL_ENABLED=true
PANEL_SESSION_TTL_MINUTES=720

# Real-time Monitor
MONITOR_POLL_INTERVAL_SECONDS=12
MONITOR_WINDOW_MINUTES=60

# Logging
LOG_LEVEL=INFO

# External APIs
# A free CoinGecko Demo key is strongly recommended: the keyless public API is
# heavily rate-limited. For a Pro key, also set
# COINGECKO_API_URL=https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_TIMEOUT_SECONDS=20

# USD Pricing — stablecoin legs are valued at $1; legs in WETH/WBNB/etc. use
# the CoinGecko price nearest the swap. "none" disables external lookups.
NATIVE_PRICE_SOURCE=coingecko
PRICE_MAX_STALENESS_MINUTES=120

# Entity clustering on nodes without trace_filter: max blocks to scan one RPC
# call at a time. 0 (default) skips funding-link clustering on such nodes.
ENTITY_SCAN_MAX_BLOCKS=0

# Bot Allowlist — comma-separated addresses to skip
BOT_ALLOWLIST=
